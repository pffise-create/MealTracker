<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>MealTracker</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>MEALTRACKER_API_BASE_URL</key>
    <string>$(MEALTRACKER_API_BASE_URL)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSCameraUsageDescription</key>
    <string>Take a meal photo to create an editable nutrition estimate.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Read weight, workouts, steps, and active energy only when you request health-informed context.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Find nearby restaurants while MealTracker is open. Location is optional.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Record a meal description for native speech transcription.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Select a meal photo to create an editable nutrition estimate.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Turn your spoken meal description into editable text.</string>
    <key>UIAppFonts</key>
    <array>
        <string>DMSans-Variable.ttf</string>
        <string>PlusJakartaSans-Variable.ttf</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
